<group name="local,syslog,sshd,authentication_failed,">
  <!-- One failed password attempt. Base rule for the frequency rule below. -->
  <rule id="100100" level="5">
    <decoded_as>msf-syslog-sshd</decoded_as>
    <match>Failed password</match>
    <description>sshd: failed password (remote syslog without header)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- 6 failures in 60 seconds from the same source IP = brute force. -->
  <rule id="100101" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>sshd: brute force, multiple failed passwords from the same IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>